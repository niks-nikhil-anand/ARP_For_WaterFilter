generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum UserRole {
  USER
  SUPERADMIN
  ADMIN
  AGENT
}

enum UserStatus {
  BLOCKED
  PENDING
  ACTIVE
}

enum NotificationCategory {
  ORDER
  PRODUCT
  INVENTORY
  USER
  SERVICE
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FLAT_RATE
}

enum ServiceEventType {
  WARRANTY
  AMC
  REPAIR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AMCStatus {
  ACTIVE
  EXPIRED
  BLOCKED
  CANCELLED
  PENDING
}

enum PaymentMethod {
  CASH
  ONLINE
  UPI
  CARD
  NET_BANKING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  ACTIVE
  CANCELLED
  COMPLETED
}

// -------------------- MODELS --------------------

// User model is the core model for all roles
model User {
  id                    Int            @id @default(autoincrement())
  name                  String
  email                 String         @unique
  password              String
  mobile                String?
  role                  UserRole       @default(USER)
  status                UserStatus     @default(PENDING)
  addresses             Address[]
  shops                 Shop[]
  agents                Agent[]
  productsCreated       Product[]
  ordersCreated         Order[]
  receivedNotifications Notification[]
  serviceEvents         ServiceEvent[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Address {
  id          Int      @id @default(autoincrement())
  type        String?
  pincode     String?
  landmark    String?
  apartmentNo String?
  state       String?
  country     String?
  locality    String?
  phone       String?
  altPhone    String?
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  shop        Shop?    @relation(fields: [shopId], references: [id])
  shopId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Represents the shop/store owner or admin
model Shop {
  id              Int            @id @default(autoincrement())
  name            String
  shopName        String?
  alternateMobile String?
  gstNumber       String?
  panNumber       String?
  user            User           @relation(fields: [userId], references: [id])
  userId          Int            @unique
  addresses       Address[]

  agents          Agent[]
  amcContracts    AMCContract[]
  notifications   Notification[]
  tickets         Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dedicated model for Service Agents
model Agent {
  id        Int            @id @default(autoincrement())
  user      User           @relation(fields: [userId], references: [id])
  userId    Int            @unique
  shop      Shop?          @relation(fields: [shopId], references: [id])
  shopId    Int?
  tasks     ServiceEvent[]
  tickets   Ticket[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// Core Product definition
model Product {
  id               Int            @id @default(autoincrement())
  uniqueId         String         @unique
  productName      String?
  description      String?
  company          String
  type             String
  color            String?
  price            Float?
  images           String[] // Array of image URLs
  featuredImageUrl String?
  offer            String?
  discount         Float?
  discountType     DiscountType?
  warrantyPeriod   String?
  status           UserStatus     @default(PENDING)
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdById      Int
  orders           Order[]
  warranties       Warranty[]
  serviceEvents    ServiceEvent[] // Includes warranty, AMC, repairs, tickets
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Defines a type of AMC contract/plan
model AMCContract {
  id            Int            @id @default(autoincrement())
  name          String
  duration      String
  price         Float
  status        AMCStatus      @default(ACTIVE)
  shop          Shop           @relation(fields: [shopId], references: [id])
  shopId        Int
  services      AMCService[]
  serviceEvents ServiceEvent[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Specific service included in an AMCContract
model AMCService {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  amcContract   AMCContract @relation(fields: [amcContractId], references: [id])
  amcContractId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// 🎯 UNIFIED MODEL FOR WARRANTY, AMC, AND REPAIR
model ServiceEvent {
  id   Int              @id @default(autoincrement())
  type ServiceEventType

  // General Details
  product    Product @relation(fields: [productId], references: [id])
  productId  Int
  customer   User?   @relation(fields: [customerId], references: [id])
  customerId Int?
  order      Order?  @relation(fields: [orderId], references: [id])
  orderId    Int?

  // Contract Details 
  startDate     DateTime?
  endDate       DateTime?
  pricePaid     Float?
  amcContract   AMCContract? @relation(fields: [amcContractId], references: [id])
  amcContractId Int?

  // Repair/Service Details 
  remarks     String?
  description String?
  parts       String?
  feedback    String?
  assignedTo  Agent?  @relation(fields: [agentId], references: [id])
  agentId     Int?

  // Internal Notes/Data
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                    Int            @id @default(autoincrement())
  product               Product        @relation(fields: [productId], references: [id])
  productId             Int

  createdBy             User?          @relation(fields: [createdById], references: [id])
  createdById           Int?
  customerName          String
  customerEmail         String?
  customerPhone         String?
  status                OrderStatus    @default(PENDING) // PENDING when created, ACTIVE when payment completed
  paymentMethod         PaymentMethod  @default(CASH)
  paymentStatus         PaymentStatus  @default(PENDING)
  transactionId         String? // For online payments
  amountPaid            Float?
  freeInstallation      Boolean        @default(false) // If free installation is included
  installationCompleted Boolean        @default(false) // Track if installation is done
  installationDate      DateTime? // When installation was completed
  freeWarranty          Boolean        @default(false) // If free warranty is included
  additionalWarranty    Boolean        @default(false) // If additional warranty was purchased
  amcPurchased          Boolean        @default(false) // If AMC was purchased with order
  serviceEvents         ServiceEvent[]
  warranties            Warranty[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

// Warranty tracking model
model Warranty {
  id                  Int       @id @default(autoincrement())
  product             Product   @relation(fields: [productId], references: [id])
  productId           Int
  order               Order     @relation(fields: [orderId], references: [id])
  orderId             Int
  warrantyType        String // "FREE" or "EXTENDED" or "BASIC"
  startDate           DateTime
  endDate             DateTime
  durationMonths      Int // Duration in months
  isActive            Boolean   @default(true)
  additionalWarranty  Boolean   @default(false) // If this is an additional/extended warranty
  warrantyAmount      Float? // Amount paid for extended warranty
  termsAndConditions  String?
  claimedDate         DateTime?
  claimDescription    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Notification {
  id          Int                  @id @default(autoincrement())
  title       String
  message     String
  category    NotificationCategory
  priority    NotificationPriority @default(MEDIUM)
  isRead      Boolean              @default(false)
  link        String?
  metadata    Json?
  recipient   User                 @relation(fields: [recipientId], references: [id])
  recipientId Int
  shop        Shop?                @relation(fields: [shopId], references: [id])
  shopId      Int?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

// Service Booking Ticket Model
model Ticket {
  id Int @id @default(autoincrement())

  // Customer Information
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?

  // Service Details
  serviceType   String // e.g., "Installation", "Repair", "AMC", "Maintenance"
  productType   String? // e.g., "RO", "UV", "Water Purifier"
  description   String? // Customer's description of the issue/requirement
  preferredDate DateTime? // Customer's preferred service date
  preferredTime String? // Customer's preferred time slot

  // Status & Priority
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  // Assignment
  assignedToAgent Agent? @relation(fields: [agentId], references: [id])
  agentId         Int?
  shop            Shop?  @relation(fields: [shopId], references: [id])
  shopId          Int?

  // Internal Notes
  internalNotes   String? // Notes for internal team
  resolutionNotes String? // Notes about how it was resolved

  // Metadata
  source   String? @default("WEBSITE") // WEBSITE, PHONE, EMAIL, etc.
  metadata Json? // Additional flexible data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
