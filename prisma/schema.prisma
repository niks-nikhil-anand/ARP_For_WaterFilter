generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum UserRole {
  USER
  SUPERADMIN
  ADMIN
  AGENT
}

enum UserStatus {
  BLOCKED
  PENDING
  ACTIVE
}

enum NotificationCategory {
  ORDER
  PRODUCT
  INVENTORY
  USER
  SERVICE
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FLAT_RATE
}

enum ServiceEventType {
  WARRANTY
  AMC
  REPAIR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AMCStatus {
  ACTIVE
  EXPIRED
  BLOCKED
  CANCELLED
  PENDING
}

enum PaymentMethod {
  CASH
  ONLINE
  UPI
  CARD
  NET_BANKING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  ACTIVE
  CANCELLED
  COMPLETED
}

// -------------------- MODELS --------------------

// User model is the core model for all roles
model User {
  id                    Int            @id @default(autoincrement())
  name                  String
  email                 String         @unique
  password              String
  mobile                String?
  role                  UserRole       @default(USER)
  adhaarNumber          String?
  panNumber             String?
  profileImageUrl       String?
  status                UserStatus     @default(PENDING)
  addresses             Address[]
  shops                 Shop[]
  agents                Agent[]
  productsCreated       Product[]
  ordersCreated         Order[]
  receivedNotifications Notification[]
  serviceEvents         ServiceEvent[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  amcs                  AMC[]
  complaints            Complaint[]
}

model Address {
  id          Int      @id @default(autoincrement())
  type        String?
  pincode     String // Required for delivery/service
  landmark    String?
  apartmentNo String?
  state       String?
  country     String?
  locality    String // Required for location
  phone       String // Required for contact
  altPhone    String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([shopId])
}

// Represents the shop/store owner or admin
model Shop {
  id              Int       @id @default(autoincrement())
  name            String
  shopName        String?
  alternateMobile String?
  gstNumber       String?
  panNumber       String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId          Int       @unique
  addresses       Address[]

  agents        Agent[]
  amcContracts  AMCContract[]
  notifications Notification[]
  tickets       Ticket[]
  amcs          AMC[]          @relation("ShopAMCs")
  serviceEvents ServiceEvent[]
  remarks       Remark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Dedicated model for Service Agents
model Agent {
  id           Int            @id @default(autoincrement())
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId       Int            @unique
  shop         Shop?          @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId       Int?
  areaCover    String? // Area or zone the agent covers
  tasks        ServiceEvent[]
  tickets      Ticket[]
  amcContracts AMCContract[]
  remarks      Remark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([shopId])
}

// Core Product definition
model Product {
  id               Int            @id @default(autoincrement())
  uniqueId         String         @unique
  productName      String?
  description      String?
  company          String
  type             String
  color            String?
  price            Decimal // Required for orders
  images           String[] // Array of image URLs
  featuredImageUrl String?
  offer            String?
  discount         Decimal?
  discountType     DiscountType?
  warrantyPeriod   String?
  isVisibleWebsite Boolean        @default(false)
  status           UserStatus     @default(PENDING)
  createdBy        User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById      Int
  orders           Order[]
  warranties       Warranty[]
  amcs             AMC[]
  amcContracts     AMCContract[]
  serviceEvents    ServiceEvent[] // Includes warranty, AMC, repairs, tickets
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([company])
  @@index([type])
}

model Order {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int

  createdBy                  User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById                Int?
  customerName               String
  customerEmail              String?
  customerPhone              String // Required for order fulfillment
  customerAltPhone           String?
  addressType                String?
  apartmentNo                String?
  locality                   String?
  landmark                   String?
  pincode                    String?
  state                      String?
  country                    String?
  status                     OrderStatus    @default(PENDING) // PENDING when created, ACTIVE when payment completed
  paymentMethod              PaymentMethod  @default(CASH)
  paymentStatus              PaymentStatus  @default(PENDING)
  transactionId              String? // For online payments
  amountPaid                 Decimal?
  discount                   Decimal?       @default(0)
  freeInstallation           Boolean        @default(false) // If free installation is included
  installationCompleted      Boolean        @default(false) // Track if installation is done
  installationDate           DateTime? // When installation was completed
  freeWarranty               Boolean        @default(false) // If free warranty is included
  additionalWarranty         Boolean        @default(false) // If additional warranty was purchased
  amcPurchased               Boolean        @default(false) // If AMC was purchased with order
  serviceEvents              ServiceEvent[]
  warranties                 Warranty[]
  amcContracts               AMCContract[]
  selectedAdditionalWarranty String? // e.g., "1year", "2year"
  selectedAMC                String? // e.g., "1year", "2year"
  deletedAt                  DateTime? // Soft delete support
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([productId, status])
  @@index([paymentStatus])
}

// Warranty tracking model
model Warranty {
  id                 Int       @id @default(autoincrement())
  product            Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId          Int
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            Int
  warrantyType       String // "FREE" or "EXTENDED" or "BASIC"
  startDate          DateTime
  endDate            DateTime
  durationMonths     Int // Duration in months
  isActive           Boolean   @default(true)
  additionalWarranty Boolean   @default(false) // If this is an additional/extended warranty
  warrantyAmount     Decimal? // Amount paid for extended warranty
  termsAndConditions String?
  claimedDate        DateTime?
  claimDescription   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isActive])
  @@index([endDate])
  @@index([orderId])
  @@index([productId])
}

// AMC tracking model (Purchased AMC)
model AMC {
  id          Int    @id @default(autoincrement())
  amcUniqueId String @unique

 


  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int

  // Customer who purchased the AMC
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId Int

  // Shop that manages/services the AMC
  shop   Shop? @relation("ShopAMCs", fields: [shopId], references: [id], onDelete: SetNull)
  shopId Int?

  // AMC Contracts (History)
  contracts AMCContract[]

  status       AMCStatus @default(ACTIVE)
  deletedAt    DateTime? // Soft delete support
  cancelledAt  DateTime? // When AMC was cancelled
  cancelReason String? // Reason for cancellation
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([shopId])
}

// Defines a type of AMC contract/plan
model AMCContract {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int
  // Parent AMC
  amc   AMC @relation(fields: [amcId], references: [id], onDelete: Cascade)
  amcId Int

  // Order that paid for this contract
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId Int

  // AMC Duration & Pricing
  startDate DateTime
  endDate   DateTime
  duration  String

  price        Decimal
  discount     Decimal?
  discountType DiscountType?
  finalPrice   Decimal

  paymentPaid     Decimal
  paymentDue      Decimal
  paymentNotes    String?
  nextPaymentDate DateTime?

  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)
  transactionId String? // For online payments

  description String?

  status AMCStatus @default(ACTIVE)

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId Int

  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId Int?

  serviceEvents ServiceEvent[]
  noOfServices  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([shopId])
  @@index([amcId])
  @@index([orderId])
}

model Notification {
  id          Int                  @id @default(autoincrement())
  title       String
  message     String
  category    NotificationCategory
  priority    NotificationPriority @default(MEDIUM)
  isRead      Boolean              @default(false)
  link        String?
  metadata    Json?
  recipient   User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int
  shop        Shop?                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      Int?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([recipientId, isRead])
  @@index([category])
  @@index([priority])
}

// Service Booking Ticket Model
model Ticket {
  id Int @id @default(autoincrement())

  // Customer Information
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?

  // Service Details
  serviceType   String // e.g., "Installation", "Repair", "AMC", "Maintenance"
  productType   String? // e.g., "RO", "UV", "Water Purifier"
  description   String? // Customer's description of the issue/requirement
  preferredDate DateTime? // Customer's preferred service date
  preferredTime String? // Customer's preferred time slot

  // Status & Priority
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  // Assignment
  assignedToAgent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId         Int?
  shop            Shop?  @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId          Int?

  // Internal Notes
  internalNotes   String? // Notes for internal team
  resolutionNotes String? // Notes about how it was resolved
  
  // Resolution Details
  timeSpent       Decimal?
  amountCollected Decimal?
  partsReplaced   String?
  workDescription String?

  // Metadata
  source   String? @default("WEBSITE") // WEBSITE, PHONE, EMAIL, etc.
  metadata Json? // Additional flexible data

  // Linked Service Event
  serviceEvent ServiceEvent?
  remarksList  Remark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([agentId])
  @@index([shopId])
  @@index([status, priority])
}

enum ServiceEventStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

// 🎯 UNIFIED MODEL FOR WARRANTY, AMC, AND REPAIR
model ServiceEvent {
  id   Int              @id @default(autoincrement())
  type ServiceEventType

  // General Details
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId  Int
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId Int?
  order      Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int?

  
  amcContract   AMCContract? @relation(fields: [amcContractId], references: [id], onDelete: SetNull)
  amcContractId Int?

  // Repair/Service Details
  status           ServiceEventStatus @default(PENDING)
  actionDate       DateTime?          // Date when the action is performed/scheduled
  scheduledDates   DateTime[]         // History/List of scheduled dates
  scheduledRemarks String?            // Remarks about scheduling
  amcEventType     String?            // Specific type for AMC events
  repairEventType  String?            // Specific type for Repair events
  remarks          String?
  description      String?
  feedback        String?
  
  // Relations
  assignedTo  Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId     Int?
  shop        Shop?              @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId      Int?
  
  // Linked Entities
  ticket      Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ticketId    Int?               @unique
  complaint   Complaint?         @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  complaintId Int?

  // Self-relation for linked events (e.g., follow-up repairs)
  relatedEvent   ServiceEvent?  @relation("RelatedEvents", fields: [relatedEventId], references: [id], onDelete: SetNull)
  relatedEventId Int?
  relatedEvents  ServiceEvent[] @relation("RelatedEvents")
  remarksList    Remark[]

  // Internal Notes/Data
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([customerId])
  @@index([agentId])
  @@index([shopId])
  @@index([productId])
  @@index([orderId])
  @@index([type, customerId])
  @@index([status])
}

model Complaint {
  id Int @id @default(autoincrement())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  serviceType    String
  preferredDate  DateTime?
  preferredTime  String?
  address        String
  description    String?
  
  serviceEvents  ServiceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum RemarkType {
  RESOLVED
  RESCHEDULED
  FOLLOW_UP
  GENERAL
}

model Remark {
  id        Int        @id @default(autoincrement())
  content   String
  type      RemarkType @default(GENERAL)
  
  // Relations (polymorphic-like but explicit)
  shop      Shop?      @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId    Int?
  agent     Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId   Int?
  
  serviceEvent   ServiceEvent? @relation(fields: [serviceEventId], references: [id], onDelete: Cascade)
  serviceEventId Int?
  
  ticket    Ticket?    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([agentId])
  @@index([serviceEventId])
  @@index([ticketId])
}
