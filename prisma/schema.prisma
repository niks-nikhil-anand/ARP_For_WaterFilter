generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum UserRole {
  USER
  SUPERADMIN
  ADMIN
  AGENT
}

enum UserStatus {
  BLOCKED
  PENDING
  ACTIVE
}

enum NotificationCategory {
  ORDER
  PRODUCT
  INVENTORY
  USER
  SERVICE
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FLAT_RATE
}

enum ServiceEventType {
  WARRANTY
  AMC
  REPAIR
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AMCStatus {
  ACTIVE
  EXPIRED
  BLOCKED
  CANCELLED
  PENDING
}

enum PaymentMethod {
  CASH
  ONLINE
  UPI
  CARD
  NET_BANKING
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  ACTIVE
  CANCELLED
  COMPLETED
}

// -------------------- MODELS --------------------

// User model is the core model for all roles
model User {
  id                    Int            @id @default(autoincrement())
  name                  String
  email                 String         @unique
  password              String
  mobile                String?
  role                  UserRole       @default(USER)
  adhaarNumber          String?
  panNumber             String?
  profileImageUrl       String?
  status                UserStatus     @default(PENDING)
  addresses             Address[]
  shops                 Shop[]
  agents                Agent[]
  productsCreated       Product[]
  ordersCreated         Order[]
  receivedNotifications Notification[]
  serviceEvents         ServiceEvent[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  amcs                  AMC[]
}

model Address {
  id          Int      @id @default(autoincrement())
  type        String?
  pincode     String // Required for delivery/service
  landmark    String?
  apartmentNo String?
  state       String?
  country     String?
  locality    String // Required for location
  phone       String // Required for contact
  altPhone    String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([shopId])
}

// Represents the shop/store owner or admin
model Shop {
  id              Int       @id @default(autoincrement())
  name            String
  shopName        String?
  alternateMobile String?
  gstNumber       String?
  panNumber       String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId          Int       @unique
  addresses       Address[]

  agents        Agent[]
  amcContracts  AMCContract[]
  notifications Notification[]
  tickets       Ticket[]
  amcs          AMC[]          @relation("ShopAMCs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Dedicated model for Service Agents
model Agent {
  id      Int            @id @default(autoincrement())
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId  Int            @unique
  shop    Shop?          @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId  Int?
  tasks   ServiceEvent[]
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([shopId])
}

// Core Product definition
model Product {
  id               Int            @id @default(autoincrement())
  uniqueId         String         @unique
  productName      String?
  description      String?
  company          String
  type             String
  color            String?
  price            Decimal // Required for orders
  images           String[] // Array of image URLs
  featuredImageUrl String?
  offer            String?
  discount         Decimal?
  discountType     DiscountType?
  warrantyPeriod   String?
  status           UserStatus     @default(PENDING)
  createdBy        User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById      Int
  orders           Order[]
  warranties       Warranty[]
  amcs             AMC[]
  serviceEvents    ServiceEvent[] // Includes warranty, AMC, repairs, tickets
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([company])
  @@index([type])
}

model Order {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int

  createdBy                  User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById                Int?
  customerName               String
  customerEmail              String?
  customerPhone              String // Required for order fulfillment
  customerAltPhone           String?
  addressType                String?
  apartmentNo                String?
  locality                   String?
  landmark                   String?
  pincode                    String?
  state                      String?
  country                    String?
  status                     OrderStatus    @default(PENDING) // PENDING when created, ACTIVE when payment completed
  paymentMethod              PaymentMethod  @default(CASH)
  paymentStatus              PaymentStatus  @default(PENDING)
  transactionId              String? // For online payments
  amountPaid                 Decimal?
  freeInstallation           Boolean        @default(false) // If free installation is included
  installationCompleted      Boolean        @default(false) // Track if installation is done
  installationDate           DateTime? // When installation was completed
  freeWarranty               Boolean        @default(false) // If free warranty is included
  additionalWarranty         Boolean        @default(false) // If additional warranty was purchased
  amcPurchased               Boolean        @default(false) // If AMC was purchased with order
  serviceEvents              ServiceEvent[]
  warranties                 Warranty[]
  amcs                       AMC[]
  selectedAdditionalWarranty String? // e.g., "1year", "2year"
  selectedAMC                String? // e.g., "1year", "2year"
  deletedAt                  DateTime? // Soft delete support
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([productId, status])
  @@index([paymentStatus])
}

// Warranty tracking model
model Warranty {
  id                 Int       @id @default(autoincrement())
  product            Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId          Int
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId            Int
  warrantyType       String // "FREE" or "EXTENDED" or "BASIC"
  startDate          DateTime
  endDate            DateTime
  durationMonths     Int // Duration in months
  isActive           Boolean   @default(true)
  additionalWarranty Boolean   @default(false) // If this is an additional/extended warranty
  warrantyAmount     Decimal? // Amount paid for extended warranty
  termsAndConditions String?
  claimedDate        DateTime?
  claimDescription   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isActive])
  @@index([endDate])
  @@index([orderId])
  @@index([productId])
}

// AMC tracking model (Purchased AMC)
model AMC {
  id          Int    @id @default(autoincrement())
  amcUniqueId String @unique

  // Relations
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int

  // Customer who purchased the AMC
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId Int

  // Shop that manages/services the AMC
  shop   Shop? @relation("ShopAMCs", fields: [shopId], references: [id], onDelete: SetNull)
  shopId Int?

  // AMC Contract Details
  amcContract   AMCContract @relation(fields: [amcContractId], references: [id], onDelete: Restrict)
  amcContractId Int

  startDate      DateTime
  endDate        DateTime
  durationMonths Int

  isActive     Boolean   @default(true)
  amountPaid   Decimal?
  status       AMCStatus @default(ACTIVE)
  deletedAt    DateTime? // Soft delete support
  cancelledAt  DateTime? // When AMC was cancelled
  cancelReason String? // Reason for cancellation
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([shopId])
  @@index([endDate])
  @@index([amcContractId])
}

// Defines a type of AMC contract/plan
model AMCContract {
  id             Int       @id @default(autoincrement())
  invoiceNumber  String    @unique
  name           String
  duration       String // e.g., "12 months", "1 year"
  durationMonths Int // Duration in months for consistency
  price          Decimal
  status         AMCStatus @default(ACTIVE)

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId Int

  serviceEvents ServiceEvent[]
  noOfServices  Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  amcs          AMC[]

  @@index([status])
  @@index([shopId])
}

model Notification {
  id          Int                  @id @default(autoincrement())
  title       String
  message     String
  category    NotificationCategory
  priority    NotificationPriority @default(MEDIUM)
  isRead      Boolean              @default(false)
  link        String?
  metadata    Json?
  recipient   User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int
  shop        Shop?                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      Int?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([recipientId, isRead])
  @@index([category])
  @@index([priority])
}

// Service Booking Ticket Model
model Ticket {
  id Int @id @default(autoincrement())

  // Customer Information
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?

  // Service Details
  serviceType   String // e.g., "Installation", "Repair", "AMC", "Maintenance"
  productType   String? // e.g., "RO", "UV", "Water Purifier"
  description   String? // Customer's description of the issue/requirement
  preferredDate DateTime? // Customer's preferred service date
  preferredTime String? // Customer's preferred time slot

  // Status & Priority
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  // Assignment
  assignedToAgent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId         Int?
  shop            Shop?  @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopId          Int?

  // Internal Notes
  internalNotes   String? // Notes for internal team
  resolutionNotes String? // Notes about how it was resolved

  // Metadata
  source   String? @default("WEBSITE") // WEBSITE, PHONE, EMAIL, etc.
  metadata Json? // Additional flexible data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([agentId])
  @@index([shopId])
  @@index([status, priority])
}

// 🎯 UNIFIED MODEL FOR WARRANTY, AMC, AND REPAIR
model ServiceEvent {
  id   Int              @id @default(autoincrement())
  type ServiceEventType

  // General Details
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId  Int
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId Int?
  order      Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int?

  // Contract Details
  startDate     DateTime?
  endDate       DateTime?
  pricePaid     Decimal?
  amcContract   AMCContract? @relation(fields: [amcContractId], references: [id], onDelete: SetNull)
  amcContractId Int?

  // Repair/Service Details
  remarks     String?
  description String?
  parts       String?
  feedback    String?
  assignedTo  Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentId     Int?

  // Internal Notes/Data
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([customerId])
  @@index([agentId])
  @@index([productId])
  @@index([orderId])
  @@index([type, customerId])
}
